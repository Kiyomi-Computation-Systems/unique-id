#!/bin/sh
# Finds Guile 3, or refuses a binary that is not it.
#
#   scripts/require-guile --find NAME...
#       Prints the first NAME on PATH that answers as Guile 3, else the first
#       NAME on PATH, else the first NAME. The Makefile takes GUILE from it
#       when none is given.
#   scripts/require-guile GUILE
#       Prints the version GUILE answers and exits 0 when it is Guile 3.
#       Otherwise names what it found on stderr and exits 1.
#
# Each binary is asked --version, under a 10-second limit where GNU timeout or
# gtimeout is on PATH, and judged by the first line it answers. The suites
# need Guile 3: its --r6rs flag, and its .sls load extension.
set -u

die() { printf 'require-guile: %s\n' "$*" >&2; exit 1; }

# ask BIN: the first line BIN answers to --version, or nothing.
ask() {
  limit=
  if command -v timeout >/dev/null 2>&1; then limit="timeout 10"
  elif command -v gtimeout >/dev/null 2>&1; then limit="gtimeout 10"
  fi
  $limit "$1" --version </dev/null 2>/dev/null | head -n 1
}

is_guile3() {
  case $1 in
    "guile (GNU Guile) 3."*) return 0 ;;
    *) return 1 ;;
  esac
}

if [ "${1:-}" = --find ]; then
  shift
  [ $# -gt 0 ] || die "--find needs at least one name"
  fallback=$1
  on_path=
  for name in "$@"; do
    command -v "$name" >/dev/null 2>&1 || continue
    [ -n "$on_path" ] || on_path=$name
    if is_guile3 "$(ask "$name")"; then
      printf '%s\n' "$name"
      exit 0
    fi
  done
  printf '%s\n' "${on_path:-$fallback}"
  exit 0
fi

[ $# -eq 1 ] || die "usage: require-guile GUILE | require-guile --find NAME..."
guile=$1
[ -n "$guile" ] || die "GUILE is empty: set GUILE to Guile 3's binary"
command -v "$guile" >/dev/null 2>&1 ||
  die "GUILE=$guile is not on PATH: install Guile 3, or set GUILE to its binary (Debian and Ubuntu also install it as guile-3.0)"
got=$(ask "$guile")
if is_guile3 "$got"; then
  printf 'check-guile: %s (%s)\n' "$got" "$guile"
  exit 0
fi
die "GUILE=$guile is not Guile 3: asked --version, it answered '${got}'. Set GUILE to Guile 3's binary."
